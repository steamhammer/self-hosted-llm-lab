# Copy to .env and fill in. .env is git-ignored and scanned by gitleaks.
# Use dedicated, revocable keys created for this project only.

# Hugging Face — read-only token (https://huggingface.co/settings/tokens)
HF_TOKEN=

# GPU providers
RUNPOD_API_KEY=
VAST_API_KEY=

# Cloudflare R2 — S3 token scoped to the results bucket only
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=llm-lab-results
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Recorded into env.json of every run (filled per rental, not secret)
PROVIDER=
GPU_PRICE_PER_HOUR_USD=
