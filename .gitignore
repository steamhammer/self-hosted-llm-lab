# Secrets — never commit. Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo
.pnpm-debug.log*

# Python
.venv/
__pycache__/
*.pyc
