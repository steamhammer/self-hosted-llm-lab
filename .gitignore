models/
hf_cache/
*.safetensors
*.gguf
*.bin

# Benchmark scratch output (curated raw results under results/raw ARE tracked)
results/tmp/
*.log

# ASR datasets (downloaded, not redistributed)
asr/data/

# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
